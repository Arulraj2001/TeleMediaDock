{
  "name": "mediadock-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "extension:dev": "pnpm --filter @mediadock/extension dev",
    "extension:build": "pnpm --filter @mediadock/extension build",
    "extension:zip": "pnpm --filter @mediadock/extension zip",
    "extension:check": "pnpm extension:build && pnpm --filter @mediadock/extension test",
    "release:prepare": "tsup-node scripts/release-prepare.ts || ts-node scripts/release-prepare.ts || npx tsx scripts/release-prepare.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,js,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,js,css}\"",
    "prepare": "husky || true"

  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "turbo": "^1.13.4",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
